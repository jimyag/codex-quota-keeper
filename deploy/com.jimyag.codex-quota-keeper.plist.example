<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jimyag.codex-quota-keeper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/codex-quota-keeper</string>
    <string>run</string>
    <string>--config</string>
    <string>/Users/REPLACE_ME/.config/codex-quota-keeper/config.json</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/codex-quota-keeper.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/codex-quota-keeper.err.log</string>
</dict>
</plist>
